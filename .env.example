# ============================================================================
# OpenRouter Agentic Proxy & Dashboard - Configuration (.env.example)
# ============================================================================

# Port du serveur HTTP (Fastify / Express Proxy & Dashboard)
PORT=3000
HOST="0.0.0.0"

# Clé API OpenRouter principale (https://openrouter.ai/keys)
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# URL de base de l'API OpenRouter
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Chaîne de fallback par défaut (séparée par des virgules)
DEFAULT_FALLBACK_MODELS="anthropic/claude-3.7-sonnet,openai/gpt-4o,deepseek/deepseek-r1,google/gemini-2.5-pro"

# Résilience & Retry (Backoff exponentiel)
PROXY_MAX_RETRIES=3
PROXY_INITIAL_BACKOFF_MS=400
PROXY_TIMEOUT_MS=30000

# Budget d'alerte par workflow d'agent (en USD)
AGENT_WORKFLOW_MAX_BUDGET_USD=2.50

# Journalisation structurée (debug | info | warn | error)
LOG_LEVEL="info"

# URL publique du déploiement (optionnel)
APP_URL="http://localhost:3000"

